#!/usr/bin/env just --justfile

prj     := "k008"
vpn_ns  := prj + "-vpn"
cli_ns  := prj + "-cli"
web_ns  := prj + "-web"

cli_ip        := "192.168.111.101"
vpn_inner_ip  := "192.168.111.1"
vpn_outter_ip := "192.168.222.1"
web_ip        := "192.168.222.2"

vpn_wg  := "10.5.0.1"
cli_wg  := "10.5.5.101"

# WireGuard keys
vpn_key := "wDr9XWC6ECSHQ257B2/hp+jldOUT/LWjy29nmsX12lQ="
vpn_pub := "SVpc9mmL3ib8eUzUWFYMDxVwChNXB9THylpBH2BEAmM="
cli_key := "qFNHSpC/v76GwH4y4IljpeoqheXzRZrT40d9Izeo7HQ="
cli_pub := "9/8FW+6zaxl774NmCk+m6470/cF9w7H4pzsQLfprjTM="

ip  := `dirname $(which ip)`
jst := `which just`

default:
    @just --list

###################################################
# Demo
###################################################

# Show network topology diagram
topo:
    #!/usr/bin/env bash
    C='\033[1;36m' Y='\033[1;33m' R='\033[0m'
    echo -e "${C}"
    echo '    cli  10.5.5.101   10.5.0.1  vpn                      web'
    echo ' ┌─────────┐             ┌───────────────┐            ┌────────┐'
    echo ' │ ── wg0 -│---tunnel----│- wg0 ────┐    │            │        │'
    echo ' │     ↕   │             │   ↕      │    │            │        │'
    echo ' │   eth0 ═╪══ netkit ═══╪═ eth0   eth1 ─┼───netkit───┼─ nk0   │'
    echo ' └─────────┘             └───────────────┘            └────────┘'
    echo ' 192.168.111.101    192.168.111.1 / 192.168.222.1  192.168.222.2'
    echo -e ""
    echo -e "   --- plain packets (inside tunnel)"
    echo -e "   ─── plain packets"
    echo -e "   ═══ encrypted packets${R}"

# Demo: Run full demo (up + topology + context + visual ping)
demo:
    #!/usr/bin/env bash
    [[ $EUID -ne 0 ]] && exec sudo -Es just demo
    just reload
    just topo
    echo ""
    just ctx
    echo ""
    just check

# Run lab in VM with specified kernel
# Run lab in VM with SSH access (connect from another terminal with: just kernel-ssh)
kernel ver="v7.0.1":
    #!/usr/bin/env bash
    [[ $EUID -ne 0 ]] && exec sudo -Es just kernel {{ver}}
    vng -r {{ver}} --name {{prj}} --ssh
    # vng -r {{ver}} --name {{prj}} --console

# Connect to running VM (started with: just kernel)
kernel-ssh:
    #!/usr/bin/env bash
    [[ $EUID -ne 0 ]] && exec sudo -Es just kernel-ssh
    vng --name {{prj}} --ssh-client
    # vng --name {{prj}} --console-client

root:
    sudo -Es

###################################################
# Lab lifecycle
###################################################

# Lab: Bring up the lab (3 namespaces, direct netkit, WireGuard)
up:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ $EUID -ne 0 ]] && exec sudo -Es just up

    if ip netns list | grep -q {{prj}}; then
        echo "Lab already running. Run: just reload" && exit 1
    fi

    # ── namespaces ─────────────────────────────────
    ip netns add {{cli_ns}}
    ip netns add {{vpn_ns}}
    ip netns add {{web_ns}}

    ip netns exec {{cli_ns}} ip link set lo up
    ip netns exec {{vpn_ns}} ip link set lo up
    ip netns exec {{web_ns}} ip link set lo up

    # ── netkit: cli ↔ vpn ──────────────────────────
    ip netns exec {{vpn_ns}} ip link add eth0 type netkit mode l2 peer name nk-cli
    ip netns exec {{vpn_ns}} ip link set nk-cli netns {{cli_ns}}
    ip netns exec {{cli_ns}} ip link set nk-cli name eth0
    ip netns exec {{vpn_ns}} ip addr add {{vpn_inner_ip}}/24 dev eth0
    ip netns exec {{vpn_ns}} ip link set eth0 up
    ip netns exec {{cli_ns}} ip addr add {{cli_ip}}/24 dev eth0
    ip netns exec {{cli_ns}} ip link set eth0 up

    # ── netkit: vpn ↔ web ──────────────────────────
    ip netns exec {{vpn_ns}} ip link add eth1 type netkit mode l2 peer name nk0
    ip netns exec {{vpn_ns}} ip link set nk0 netns {{web_ns}}
    ip netns exec {{vpn_ns}} ip addr add {{vpn_outter_ip}}/24 dev eth1
    ip netns exec {{vpn_ns}} ip link set eth1 up
    ip netns exec {{web_ns}} ip addr add {{web_ip}}/24 dev nk0
    ip netns exec {{web_ns}} ip link set nk0 up

    # ── WireGuard: vpn (server) ────────────────────
    ip netns exec {{vpn_ns}} ip link add wg0 type wireguard
    ip netns exec {{vpn_ns}} ip addr add {{vpn_wg}}/16 dev wg0
    echo '{{vpn_key}}' | ip netns exec {{vpn_ns}} wg set wg0 \
        listen-port 51820 private-key /dev/stdin
    ip netns exec {{vpn_ns}} wg set wg0 peer {{cli_pub}} allowed-ips {{cli_wg}}/32
    ip netns exec {{vpn_ns}} ip link set wg0 up

    # ── WireGuard: cli (client) ────────────────────
    ip netns exec {{cli_ns}} ip link add wg0 type wireguard
    ip netns exec {{cli_ns}} ip addr add {{cli_wg}}/16 dev wg0
    echo '{{cli_key}}' | ip netns exec {{cli_ns}} wg set wg0 \
        private-key /dev/stdin \
        peer {{vpn_pub}} \
            endpoint {{vpn_inner_ip}}:51820 \
            allowed-ips 0.0.0.0/0 \
            persistent-keepalive 25
    ip netns exec {{cli_ns}} ip link set wg0 up

    # ── routing ────────────────────────────────────
    ip netns exec {{cli_ns}} ip route add {{web_ip}} via {{vpn_wg}}
    ip netns exec {{vpn_ns}} sysctl -qw net.ipv4.ip_forward=1
    ip netns exec {{web_ns}} ip route add default via {{vpn_outter_ip}}

    echo "* Lab is up."

# Lab: Tear down
down mode="verbose":
    #!/usr/bin/env bash
    [[ $EUID -ne 0 ]] && exec sudo -Es just down {{mode}}
    ns=$(ip netns list | awk '/{{prj}}/{print $1}')
    if [ -z "$ns" ]; then
        [[ "{{mode}}" != "quiet" ]] && echo "Nothing to tear down."
        exit 0
    fi
    echo "$ns" | xargs -rn1 ip netns del
    echo "* Lab torn down."

# Lab: Tear down and bring back up
reload: (down "quiet") up


# Show host and lab context
ctx:
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[1;33m' R='\033[0m'

    echo -e "${G}═════════════════════════  HOST  ═══════════════════════════════${R}"
    echo -e "  kernel:   ${Y}$(uname -r)${R}"
    echo -e "  hostname: ${Y}$(hostname)${R}"
    echo "  user:     $(id -un) (uid=$(id -u))"
    echo ""

    echo -e "${G}════════════════════  LAB NAMESPACES  ══════════════════════════${R}"
    namespaces=$(ip netns list | grep {{prj}} | sort || true)
    [[ "$namespaces" == "" ]] && echo -e "<none>\n" && exit 0
    # echo -e "$namespaces\n"

    for ns in $namespaces; do
        echo -e "${C}  $ns ${R}"
        fmt='.[] | "     \(.ifindex) \(.ifname)\t\(.operstate)\t\([.addr_info[]? | select(.family=="inet") | .local] | join(" "))"'
        ip netns exec "$ns" ip -j addr | jq -r "$fmt"
    done
    echo ""

    echo -e "${G}═════════════════════  WG HANDSHAKES  ══════════════════════════${R}"
    echo -n "    cli: "; ip netns exec {{cli_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'
    echo -n "    vpn: "; ip netns exec {{vpn_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'

# Visual ping: cli → vpn (underlay) → vpn (tunnel) → web (through tunnel)
check count="3":
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[1;33m' R='\033[0m'
    run() { echo -e "${G}▶▶▶ $1${R}"; shift; "$@"; echo; }

    echo -e "${G}════════════════════════  CHECK  ═══════════════════════════════${R}"
    run "client --> vpn (underlay {{vpn_inner_ip}})"
    echo -ne "  ${Y}ROUTE:${R} "
    ip netns exec {{cli_ns}} ip route get {{vpn_inner_ip}} | head -n1
    echo -ne "  ${Y}PING:${R} "
    ip netns exec {{cli_ns}} ping -q -c{{count}} -W1 {{vpn_inner_ip}}
    echo ""

    run "client --> vpn (tunnel {{vpn_wg}})"
    echo -ne "  ${Y}ROUTE:${R} "
    ip netns exec {{cli_ns}} ip route get {{vpn_wg}} | head -n1
    echo -ne "  ${Y}PING:${R} "
    ip netns exec {{cli_ns}} ping -q -c{{count}} -W1 {{vpn_wg}}
    echo ""

    run "client --> web (through tunnel {{web_ip}})"
    echo -ne "  ${Y}ROUTE:${R} "
    ip netns exec {{cli_ns}} ip route get {{web_ip}} | head -n1
    echo -ne "  ${Y}PING:${R} "
    ip netns exec {{cli_ns}} ping -q -c{{count}} -W5 {{web_ip}}
    echo ""

    echo "* Lab check is OK"


shell-cli: (_shell cli_ns)
shell-vpn: (_shell vpn_ns)
shell-web: (_shell web_ns)

exec-cli *ARGS: (_exec cli_ns ARGS)
exec-vpn *ARGS: (_exec vpn_ns ARGS)
exec-web *ARGS: (_exec web_ns ARGS)


# Enter shell in namespace
_shell ns:
    @sudo PATH="$PATH" ip netns exec {{ns}} bash -c 'echo -n "Enter namespace: "; ip netns identify; exec bash'

# Execute command in namespace
_exec ns *ARGS:
    @sudo PATH="$PATH" ip netns exec {{ns}} bash -c 'echo -n "Run in namespace: "; ip netns identify; bash -c "{{ARGS}}"'
