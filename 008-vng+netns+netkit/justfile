#!/usr/bin/env just --justfile

prj     := "k008"
vpn_ns  := prj + "-vpn"
cli_ns  := prj + "-cli"
web_ns  := prj + "-web"

cli_ip        := "192.168.111.101"
vpn_inner_ip  := "192.168.111.1"
vpn_outter_ip := "192.168.222.1"
web_ip        := "192.168.222.80"

vpn_wg  := "10.5.0.1"
cli_wg  := "10.5.5.101"

# WireGuard keys
vpn_key := "wDr9XWC6ECSHQ257B2/hp+jldOUT/LWjy29nmsX12lQ="
vpn_pub := "SVpc9mmL3ib8eUzUWFYMDxVwChNXB9THylpBH2BEAmM="
cli_key := "qFNHSpC/v76GwH4y4IljpeoqheXzRZrT40d9Izeo7HQ="
cli_pub := "9/8FW+6zaxl774NmCk+m6470/cF9w7H4pzsQLfprjTM="

# Link type: "netkit" (kernel >= 6.7) or "veth" (older kernels)
link      := "netkit"
link_type := if link == "netkit" { "netkit mode l2" } \
             else if link == "veth" { "veth" } \
             else { error("unknown link type: " + link) }

help:
    @just --list

# For lazy
root:
    sudo -Es

###################################################
# Lab demo
###################################################

# Full demo: up + status + ping
demo: reload status (ping "brief")

###################################################
# Lifecycle
###################################################

# Bring up the lab
up:
    #!/usr/bin/env bash
    set -euo pipefail
    sudo -v

    if sudo ip netns list | grep -q {{prj}}; then
        echo "Lab already running. Run: just reload" && exit 1
    fi

    # ── namespaces ─────────────────────────────────
    sudo ip netns add {{cli_ns}}
    sudo ip netns add {{vpn_ns}}
    sudo ip netns add {{web_ns}}

    sudo ip netns exec {{cli_ns}} ip link set lo up
    sudo ip netns exec {{vpn_ns}} ip link set lo up
    sudo ip netns exec {{web_ns}} ip link set lo up

    # ── link: cli ↔ vpn ──────────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add eth0 type {{link_type}} peer name nk-cli
    sudo ip netns exec {{vpn_ns}} ip link set nk-cli netns {{cli_ns}}
    sudo ip netns exec {{cli_ns}} ip link set nk-cli name eth0
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_inner_ip}}/24 dev eth0
    sudo ip netns exec {{vpn_ns}} ip link set eth0 up
    sudo ip netns exec {{cli_ns}} ip addr add {{cli_ip}}/24 dev eth0
    sudo ip netns exec {{cli_ns}} ip link set eth0 up

    # ── link: vpn ↔ web ──────────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add eth1 type {{link_type}} peer name nk0
    sudo ip netns exec {{vpn_ns}} ip link set nk0 netns {{web_ns}}
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_outter_ip}}/24 dev eth1
    sudo ip netns exec {{vpn_ns}} ip link set eth1 up
    sudo ip netns exec {{web_ns}} ip addr add {{web_ip}}/24 dev nk0
    sudo ip netns exec {{web_ns}} ip link set nk0 up

    # ── WireGuard: vpn (server) ────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add wg0 type wireguard
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_wg}}/16 dev wg0
    echo '{{vpn_key}}' | sudo ip netns exec {{vpn_ns}} wg set wg0 \
        listen-port 51820 private-key /dev/stdin
    sudo ip netns exec {{vpn_ns}} wg set wg0 peer {{cli_pub}} allowed-ips {{cli_wg}}/32
    sudo ip netns exec {{vpn_ns}} ip link set wg0 up

    # ── WireGuard: cli (client) ────────────────────
    sudo ip netns exec {{cli_ns}} ip link add wg0 type wireguard
    sudo ip netns exec {{cli_ns}} ip addr add {{cli_wg}}/16 dev wg0
    echo '{{cli_key}}' | sudo ip netns exec {{cli_ns}} wg set wg0 \
        private-key /dev/stdin \
        peer {{vpn_pub}} \
            endpoint {{vpn_inner_ip}}:51820 \
            allowed-ips 0.0.0.0/0 \
            persistent-keepalive 25
    sudo ip netns exec {{cli_ns}} ip link set wg0 up

    # ── routing ────────────────────────────────────
    sudo ip netns exec {{cli_ns}} ip route add {{web_ip}} via {{vpn_wg}}
    sudo ip netns exec {{vpn_ns}} sysctl -qw net.ipv4.ip_forward=1
    sudo ip netns exec {{web_ns}} ip route add default via {{vpn_outter_ip}}

    echo "* Lab is up."

# Tear down the lab
down mode="verbose":
    #!/usr/bin/env bash
    sudo -v
    ns=$(sudo ip netns list | awk '/{{prj}}/{print $1}')
    [[ -z "$ns" ]] && { [[ "{{mode}}" != "quiet" ]] && echo "Nothing to tear down."; exit 0; }
    echo "$ns" | xargs -rn1 sudo ip netns del
    echo "* Lab torn down."

# Tear down and bring back up
reload: (down "quiet") up

# Run lab in VM (usermod -aG kvm $USER)
kernel ver="v7.0.1":
    vng -r {{ver}} --name {{prj}} --ssh

# Connect to running VM
kernel-ssh:
    vng --name {{prj}} --ssh-client


###################################################
# Lab
###################################################

# Enter machine or run command
enter machine *ARGS:
    #!/usr/bin/env bash
    case "{{machine}}" in
        vpn) ns="{{vpn_ns}}" ;;
        cli) ns="{{cli_ns}}" ;;
        web) ns="{{web_ns}}" ;;
        *)   echo "Unknown: {{machine}} (try: vpn, cli, web)"; exit 1 ;;
    esac
    if [[ -z "{{ARGS}}" ]]; then
        sudo HOME="$HOME" ip netns exec "$ns" unshare --uts bash -c \
            'hostname {{machine}}; exec bash --rcfile <(echo "HISTFILE=/tmp/{{prj}}-{{machine}}.history; PS1=\"\[\e[1;32m\]\h\[\e[0m\]:\w\\$ \"")'
    else
        sudo ip netns exec "$ns" {{ARGS}}
    fi

# Topology + live lab state
status:
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[1;33m' D='\033[2m' R='\033[0m'

    echo -e "${G}═══════════════════════  TOPOLOGY  ═════════════════════════════${R}"
    echo -e "${D}"
    topo=$(sed -n '/<!-- topology -->/,/<!-- \/topology -->/{//d;/^```/d;p}' README.md)
    [[ "{{link}}" == "veth" ]] && topo=$(echo "$topo" | sed 's/ netkit /═ veth ═/; s/netkit/ veth /')
    echo "$topo"
    echo -e "${R}"

    echo -e "${G}═════════════════════════  HOST  ═══════════════════════════════${R}"
    echo -e "  kernel:   ${Y}$(uname -r)${R}"
    echo -e "  hostname: ${Y}$(hostname)${R}"
    echo -e "  link:     ${Y}{{link_type}}${R}"
    # if sudo ip netns list | grep -q {{prj}}; then
    #     actual=$(sudo ip netns exec {{vpn_ns}} ip -d -j link show eth0 \
    #         | jq -r '.[0] | .linkinfo.info_kind + (if .linkinfo.info_data.mode then " mode " + .linkinfo.info_data.mode else "" end)')
    #     echo -e "  actual:   ${D}${actual}${R}"
    # fi
    # echo "  user:     $(id -un) (uid=$(id -u))"
    echo ""

    echo -e "${G}════════════════════  LAB NAMESPACES  ══════════════════════════${R}"
    namespaces=$(sudo ip netns list | grep {{prj}} | sort || true)
    if [[ -z "$namespaces" ]]; then
        echo -e "  ${Y}Lab is not running.${R} Run: just up"
        echo ""
        exit 0
    fi

    for ns in $namespaces; do
        echo -e "${C}  $ns ${R}"
        fmt='.[] | "     \(.ifindex) \(.ifname)\t\(.operstate)\t\([.addr_info[]? | select(.family=="inet") | .local] | join(" "))"'
        sudo ip netns exec "$ns" ip -j addr | jq -r "$fmt"
    done
    echo ""

    echo -e "${G}═════════════════════  WG HANDSHAKES  ══════════════════════════${R}"
    echo -n "    cli: "; sudo ip netns exec {{cli_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'
    echo -n "    vpn: "; sudo ip netns exec {{vpn_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'

# Ping connectivity checks
ping mode="verbose" count="3":
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[0;33m' R='\033[0m'

    check() {
        local label="$1" ns="{{cli_ns}}" ip="$2" timeout="$3"
        if [[ "{{mode}}" == "brief" ]]; then
            if sudo ip netns exec "$ns" ping -q -c1 -W"$timeout" "$ip" &>/dev/null; then
                avg=$(sudo ip netns exec "$ns" ping -q -c{{count}} -W"$timeout" "$ip" 2>/dev/null \
                    | awk -F'/' '/^rtt/{printf "%.1fms", $5}')
                echo -e "  $label  ${G}OK${R}  (${avg})"
            else
                echo -e "  $label  ${C}FAIL${R}"
                return 1
            fi
        else
            echo -e "${G}▶▶▶ $label${R}"
            echo -ne "  ${Y}ROUTE:${R} "
            sudo ip netns exec "$ns" ip route get "$ip" | head -n1
            echo -ne "  ${Y}PING:${R} "
            sudo ip netns exec "$ns" ping -c{{count}} -W"$timeout" "$ip"
            echo ""
        fi
    }

    echo -e "${G}═════════════════════════  PING  ═══════════════════════════════${R}"
    check "cli --> vpn (underlay)      " {{vpn_inner_ip}} 1
    check "cli --> vpn (tunnel)        " {{vpn_wg}}       1
    check "cli --> vpn (tunnel) --> web" {{web_ip}}        5
    if [[ "{{mode}}" != "brief" ]]; then
        echo -e "* ${G}OK${R}"
    fi
