#!/usr/bin/env just --justfile

prj     := "k007"
vpn_ns  := prj + "-vpn"
cli_ns  := prj + "-cli"
net_ns  := prj + "-net"
web_ns  := prj + "-web"

cli_ip        := "192.168.111.101"
net_br        := "192.168.111.254"
vpn_inner_ip  := "192.168.111.1"

vpn_outter_ip := "192.168.222.1"
web_ip        := "192.168.222.80"

vpn_wg        := "10.5.0.1"
cli_wg        := "10.5.5.101"

# WireGuard keys
vpn_key := "wDr9XWC6ECSHQ257B2/hp+jldOUT/LWjy29nmsX12lQ="
vpn_pub := "SVpc9mmL3ib8eUzUWFYMDxVwChNXB9THylpBH2BEAmM="
cli_key := "qFNHSpC/v76GwH4y4IljpeoqheXzRZrT40d9Izeo7HQ="
cli_pub := "9/8FW+6zaxl774NmCk+m6470/cF9w7H4pzsQLfprjTM="

app := "target/x86_64-unknown-linux-musl/debug/poc"

# Link type: "netkit" (kernel >= 6.7) or "veth" (older kernels)
link      := "netkit"
link_type := if link == "netkit" { "netkit mode l2" } \
             else if link == "veth" { "veth" } \
             else { error("unknown link type: " + link) }

ping_interval := "0.05"

###################################################
###################################################
 
help:
    @just --list

caps:
    #!/usr/bin/env bash
    if (( 0x$(awk '/^CapEff/{print $2}' /proc/$$/status) )); then
        echo "Already in capability shell." >&2; exit 1
    fi
    if grep -q virtme /proc/cmdline; then
        echo "Already privileged inside the VM." >&2; exit 1
    fi
    case "$(basename "$SHELL")" in
      fish) launch='exec fish -C "functions -c fish_prompt _k; function fish_prompt; set_color FF8800 -o; printf \"⚡ \"; set_color normal; _k; end"' ;;
      *)    launch='exec bash --rcfile <(cat ~/.bashrc 2>/dev/null; echo "PS1=\"⚡ \$PS1\"")' ;;
    esac
    exec sudo -E capsh --keep=1 --user="$(id -un)" \
        --inh=cap_bpf,cap_perfmon,cap_net_admin,cap_sys_admin \
        --addamb=cap_bpf,cap_perfmon,cap_net_admin,cap_sys_admin \
        -- -c "$launch"

# Run lab in VM (usermod -aG kvm $USER) — from a normal terminal, not `just caps`
kernel ver="v7.0.1":
    #!/usr/bin/env bash
    if (( 0x$(awk '/^CapEff/{print $2}' /proc/$$/status) )); then
        echo "In a capability shell. Exit it to run VM." >&2; exit 1
    fi
    vng -r {{ver}} --name {{prj}} --ssh

# Connect to running VM
kernel-ssh:
    vng --name {{prj}} --ssh-client


###################################################
# Lifecycle
###################################################

# Bring up the lab
up:
    #!/usr/bin/env bash
    set -euo pipefail

    if ip netns list | grep -q {{prj}}; then
        echo "Lab already running. Run: just reload" && exit 1
    fi

    # ── namespaces ─────────────────────────────────
    sudo -v
    sudo ip netns add {{vpn_ns}}
    sudo ip netns add {{cli_ns}}
    sudo ip netns add {{net_ns}}
    sudo ip netns add {{web_ns}}

    sudo ip netns exec {{vpn_ns}} ip link set lo up
    sudo ip netns exec {{cli_ns}} ip link set lo up
    sudo ip netns exec {{net_ns}} ip link set lo up
    sudo ip netns exec {{web_ns}} ip link set lo up

    # ── bridge: cli - net - vpn ────────────────────
    sudo ip netns exec {{net_ns}} ip link add br0 type bridge

    # ── link: vpn ↔ net ────────────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add eth0 type {{link_type}} peer name nk-vpn
    sudo ip netns exec {{vpn_ns}} ip link set nk-vpn netns {{net_ns}}
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_inner_ip}}/24 dev eth0
    sudo ip netns exec {{vpn_ns}} ip link set eth0 up

    # ── link: cli ↔ net ────────────────────────────
    sudo ip netns exec {{cli_ns}} ip link add eth0 type {{link_type}} peer name nk-cli
    sudo ip netns exec {{cli_ns}} ip link set nk-cli netns {{net_ns}}
    sudo ip netns exec {{cli_ns}} ip addr add {{cli_ip}}/24 dev eth0
    sudo ip netns exec {{cli_ns}} ip link set eth0 up

    # ── link: vpn ↔ web ────────────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add eth1 type {{link_type}} peer name nk0
    sudo ip netns exec {{vpn_ns}} ip link set nk0 netns {{web_ns}}
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_outter_ip}}/24 dev eth1
    sudo ip netns exec {{vpn_ns}} ip link set eth1 up
    sudo ip netns exec {{web_ns}} ip addr add {{web_ip}}/24 dev nk0
    sudo ip netns exec {{web_ns}} ip link set nk0 up

    # ── bridge ports ───────────────────────────────
    sudo ip netns exec {{net_ns}} ip link set nk-cli master br0
    sudo ip netns exec {{net_ns}} ip link set nk-vpn master br0
    sudo ip netns exec {{net_ns}} ip addr add {{net_br}}/24 dev br0
    sudo ip netns exec {{net_ns}} ip link set nk-vpn up
    sudo ip netns exec {{net_ns}} ip link set nk-cli up
    sudo ip netns exec {{net_ns}} ip link set br0 up

    # ── WireGuard: vpn (server) ────────────────────
    sudo ip netns exec {{vpn_ns}} ip link add wg0 type wireguard
    sudo ip netns exec {{vpn_ns}} ip addr add {{vpn_wg}}/16 dev wg0
    echo '{{vpn_key}}' | sudo ip netns exec {{vpn_ns}} wg set wg0 \
        listen-port 51820 private-key /dev/stdin
    sudo ip netns exec {{vpn_ns}} wg set wg0 peer {{cli_pub}} allowed-ips {{cli_wg}}/32
    sudo ip netns exec {{vpn_ns}} ip link set wg0 up

    # ── WireGuard: cli (client) ────────────────────
    sudo ip netns exec {{cli_ns}} ip link add wg0 type wireguard
    sudo ip netns exec {{cli_ns}} ip addr add {{cli_wg}}/16 dev wg0
    echo '{{cli_key}}' | sudo ip netns exec {{cli_ns}} wg set wg0 \
        private-key /dev/stdin \
        peer {{vpn_pub}} \
            endpoint {{vpn_inner_ip}}:51820 \
            allowed-ips 0.0.0.0/0 \
            persistent-keepalive 25
    sudo ip netns exec {{cli_ns}} ip link set wg0 up

    # ── routing ────────────────────────────────────
    sudo ip netns exec {{cli_ns}} ip route add {{web_ip}} via {{vpn_wg}}
    sudo ip netns exec {{vpn_ns}} sysctl -qw net.ipv4.ip_forward=1
    sudo ip netns exec {{web_ns}} ip route add default via {{vpn_outter_ip}}

    echo "* Lab is up."

# Tear down the lab
down mode="verbose":
    #!/usr/bin/env bash
    ns=$(ip netns list | awk '/{{prj}}/{print $1}')
    [[ -z "$ns" ]] && { [[ "{{mode}}" != "quiet" ]] && echo "Nothing to tear down."; exit 0; }
    echo "$ns" | xargs -rn1 sudo ip netns del
    echo "* Lab torn down."

# Tear down and bring back up
reload: (down "quiet") up

###################################################
# Lab
###################################################

# Enter machine or run command
enter machine *ARGS:
    #!/usr/bin/env bash
    case "{{machine}}" in
        vpn) ns="{{vpn_ns}}" ;;
        cli) ns="{{cli_ns}}" ;;
        net) ns="{{net_ns}}" ;;
        web) ns="{{web_ns}}" ;;
        *)   echo "Unknown: {{machine}} (try: vpn, cli, net, web)"; exit 1 ;;
    esac
    if [[ -z "{{ARGS}}" ]]; then
        ip netns exec "$ns" unshare --uts bash -c \
            'hostname {{machine}}; exec bash --rcfile <(echo "HISTFILE=/tmp/{{prj}}-{{machine}}.history; PS1=\"\[\e[1;32m\]\h\[\e[0m\]:\w\\$ \"")'
    else
        ip netns exec "$ns" {{ARGS}}
    fi

# Topology + live lab state
status:
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[1;33m' D='\033[2m' R='\033[0m'

    lnk=""
    if ip netns list | grep -q {{prj}}; then
        lnk=$(ip netns exec {{vpn_ns}} ip -j -d link show eth0 | jq -r '.[0].linkinfo.info_kind')
    fi

    echo -e "${G}═══════════════════════  TOPOLOGY  ════════════════════════════════════════════${R}"
    echo -e "${D}"
    sed -n '/<!-- topology -->/,/<!-- \/topology -->/{//d;/^```/d;p}' README.md
    echo -e "${R}"

    echo -e "${G}═════════════════════════  HOST  ═══════════════════════════════${R}"
    echo -e "  kernel:   ${Y}$(uname -r)${R}"
    echo -e "  hostname: ${Y}$(hostname)${R}"
    [[ -n "$lnk" ]] && echo -e "  link:     ${Y}${lnk}${R}"
    echo ""

    echo -e "${G}════════════════════  LAB NAMESPACES  ══════════════════════════${R}"
    namespaces=$(ip netns list | grep {{prj}} | sort || true)
    if [[ -z "$namespaces" ]]; then
        echo -e "  ${Y}Lab is not running.${R} Run: just up"
        echo ""
        exit 0
    fi

    for ns in $namespaces; do
        echo -e "${C}  $ns ${R}"
        fmt='.[] | "     \(.ifindex) \(.ifname)\t\(.operstate)\t\([.addr_info[]? | select(.family=="inet") | .local] | join(" "))"'
        ip netns exec "$ns" ip -j addr | jq -r "$fmt"
    done
    echo ""

    echo -e "${G}═════════════════════  WG HANDSHAKES  ══════════════════════════${R}"
    echo -n "    cli: "; ip netns exec {{cli_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'
    echo -n "    vpn: "; ip netns exec {{vpn_ns}} wg show wg0 | grep -oP 'latest handshake: \K.*'

# Ping connectivity checks
ping mode="verbose" count="3":
    #!/usr/bin/env bash
    set -euo pipefail
    G='\033[1;32m' C='\033[1;36m' Y='\033[0;33m' R='\033[0m'

    check() {
        local label="$1" ns="{{cli_ns}}" ip="$2" timeout="$3"
        if [[ "{{mode}}" == "brief" ]]; then
            if ip netns exec "$ns" ping -q -c1 -W"$timeout" "$ip" &>/dev/null; then
                avg=$(ip netns exec "$ns" \
                    ping -q -c{{count}} -i{{ping_interval}} -W"$timeout" "$ip" 2>/dev/null \
                        | awk -F'/' '/^rtt/{printf "%.1fms", $5}')
                echo -e "  $label  ${G}OK${R}  (${avg})"
            else
                echo -e "  $label  ${C}FAIL${R}"
                return 1
            fi
        else
            echo -e "${G}▶▶▶ $label${R}"
            echo -ne "  ${Y}ROUTE:${R} "
            ip netns exec "$ns" ip route get "$ip" | head -n1
            echo -ne "  ${Y}PING:${R} "
            ip netns exec "$ns" ping -c{{count}} -i{{ping_interval}} -W"$timeout" "$ip"
            echo ""
        fi
    }

    echo -e "${G}═════════════════════════  PING  ═══════════════════════════════${R}"
    check "cli --> vpn (underlay)      " {{vpn_inner_ip}} 1
    check "cli --> vpn (tunnel)        " {{vpn_wg}}       1
    check "cli --> vpn (tunnel) --> web" {{web_ip}}       5
    if [[ "{{mode}}" != "brief" ]]; then
        echo -e "* ${G}OK${R}"
    fi

###################################################
# Dev (eBPF tracing)
###################################################

build *args:
    cargo build {{args}}

run *args:
    cargo run {{args}}

# Watch + build
dev-build:
    cargo watch --clear -x build

# Watch + run with entr
dev-run *args:
    echo {{app}} | entr -rc {{app}} {{args}}

# Watch + build + run
dev-host *args:
    cargo watch --clear -x "build" -s "\
        chown $(logname):$(logname) -R target ;\
        cargo run -- {{args}}"

# Watch + build + run in vpn ns
dev *args:
    cargo watch --clear -x "build" -s "\
        chown $(logname):$(logname) -R target ;\
        ip netns exec {{vpn_ns}} $(pwd)/{{app}} --wg wg0 --iface eth0 {{args}}"
